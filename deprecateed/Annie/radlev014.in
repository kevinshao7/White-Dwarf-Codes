## 0 Force Applied - Template

# -------------------- Initialization --------------------

units cgs
dimension 3
atom_style atomic
atom_modify map yes
pair_style yukawa 7.66e8 1e-8
boundary p p p
region simulation_box block -1 1 -1 1 -1 1
create_box 2 simulation_box

# -------------------- Changeable Parameters/System Definition ---------------------

create_atoms 1 random 100000 164276 NULL
create_atoms 2 random 1000 465835 NULL
group hydrogen type 1
group silicon type 2
mass 1 1.673e-24 #g
mass 2 4.6637e-23 #g

variable dense equal 1.0 #g/cm^3
variable mytemp equal 60000.0 #K
variable myforce equal 2.46e14*4.664e-23


timestep 2.0e-17

# -------------------- Simulation Settings --------------------

variable myhydrogen equal mass(hydrogen) #g
variable mysilicon equal mass(silicon) #g (total mass of all particles)
variable vole equal (${myhydrogen}+${mysilicon})/${dense} #cm^3
variable side equal (${vole}^(1/3))/2 #cm -> side coordinate

change_box all x scale ${side} remap
change_box all y scale ${side} remap
change_box all z scale ${side} remap

variable n equal ${side}/10
neigh_modify every 1 delay 0 check yes
neighbor ${n} bin
pair_coeff 1 1 2.31e-19 #erg*cm
pair_coeff 2 2 3.069e-18

# -------------------- Visualization --------------------

variable time equal time
variable z equal z[2]
variable vz equal vz[2]
variable ke equal ke
variable pe equal pe
variable te equal etotal

variable vcmHx equal vcm(hydrogen,x)
variable vcmHy equal vcm(hydrogen,y)
variable vcmHz equal vcm(hydrogen,z)

variable vcmSix equal vcm(silicon,x)
variable vcmSiy equal vcm(silicon,y)
variable vcmSiz equal vcm(silicon,z)

variable vcmx equal vcm(all,x)
variable vcmy equal vcm(all,y)
variable vcmz equal vcm(all,z)

variable zvcm equal xcm(silicon,z)

#dump velocities all custom 1000 velocity00_t*.dump type vx vy vz
compute Sitemp silicon temp

#thermo_style custom step temp c_Sitemp dt cpu atoms ke pe etotal vol press density v_vcmHx v_vcmHy v_vcmHz v_vcmSix v_vcmSiy v_vcmSiz 

thermo_style custom step temp v_vcmx v_vcmy v_vcmz v_vcmHx v_vcmHy v_vcmHz v_vcmSix v_vcmSiy v_vcmSiz v_zvcm


thermo 1000
 
# -------------------- Run --------------------

velocity all create ${mytemp} 68534 dist gaussian
variable dist equal ${n}/60
min_modify dmax ${dist}
minimize 1e-7 1e-7 10000 100000
variable step equal step

fix mynvt all nvt temp ${mytemp} ${mytemp} $(100.0*dt)
run 1000

unfix mynvt

fix mynve all nve
fix radaccel silicon addforce 0 0 ${myforce}

compute newT all temp/partial 1 1 0
thermo_modify temp newT

run 100000000