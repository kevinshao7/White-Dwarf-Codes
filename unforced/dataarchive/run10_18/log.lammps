LAMMPS (23 Jun 2022 - Update 1)
#module load mpi/openmpi-x86_64
#for f in *.sh; do sbatch "$f"; done


# -----------Changeable parameters -----------
variable vb equal 9.0e+06
variable T0 equal 5.00000e+03
variable rhoH equal 1.00000e+00
variable rhoS equal 7.45000e+00 #gcc
variable ZH equal 6.50000e-01
variable ZSi equal 3.82000e+00
variable ccs equal 9.32708e-17 #collision cross section in cm^2
variable dtfrac equal 1e-2
variable offangle equal 0.3 #offset angle in radians to prevent overlapping tracks

# --------------Constants
variable avogadro equal 6.022e23
variable mH equal $(0.001*1.008/v_avogadro) #Hydrogen mass kg/atom
variable mH equal 1.6738625041514447162e-27 
variable mSi equal $(0.001*28.09/v_avogadro) #Silicon mass kg/atom
variable mSi equal 4.6645632680172696525e-26 
variable NH equal 500000
variable NSi equal 2000
variable kb equal 1.38e-23 #SI units
variable ctostatc equal 2.99792e9 #coulomb to statcoulomb
variable qe equal 1.60217663e-19 #SI units
variable me equal 9.1093837e-31 #SI units electron mass
variable e0 equal 8.8541878188e-12 #SI units permittivity
variable pi equal 3.141592653589793238
variable hbar equal 1.054571817e-34

# --- Calculations
variable vthh equal $(100*sqrt(3*v_kb*v_T0/v_mH)) #hydrogen thermal velocity in cm/s
variable vthh equal 1112052.4782067243941 
variable vths equal $(100*sqrt(3*v_kb*v_T0/v_mSi)) #silicon thermal velocity in cm/s
variable vths equal 210658.83530348405475 
variable ndens equal $(v_rhoH/(1000*v_mH)) #number density in cm^-3
variable ndens equal 5.9742063492063652794e+23 
variable vrel equal $(v_vthh+v_vths+v_vb)
variable vrel equal 10322711.313510203734
variable collfreq equal $(v_ndens*v_ccs*v_vrel)
variable collfreq equal 575201093275125.625
variable vol equal $((1000*(v_mH*v_NH)/v_rhoH)+(1000*(v_mSi*v_NSi)/v_rhoS)) #cm^3
variable vol equal 8.4945356957375293465e-19 
variable side equal $((v_vol^(1/3))) #cm -> side coordinate
variable side equal 9.4706520693321335829e-07 
variable dt equal $(v_dtfrac*v_side/((v_vthh+v_vb)*((v_NH+v_NSi)^(1/3))))
variable dt equal 1.1784359821947552981e-17

# -- Screening Length
variable ne equal $(1e6*v_avogadro*v_ZH*v_rhoH/1.008) #electron number density SI
variable ne equal 3.8832341269841271663e+29 
variable ve equal $(sqrt(3*v_kb*v_T0/v_me))
variable ve equal 476695.08590846124571
variable wp equal $(sqrt(v_ne*(v_qe^2)/(v_me*v_e0)))
variable wp equal 35155098381018164
variable lD equal $(v_ve/v_wp)
variable lD equal 1.3559771067682458896e-11
variable TF equal $(((3*v_ne*(v_pi^2))^(2/3))*(v_hbar^2)/(2*v_me*v_kb))
variable TF equal 225336.02444154096884
variable lS equal $(v_lD*((1+(2*v_TF/(4*v_T0)))^(1/4)))
variable lS equal 2.9865821180482880998e-11
variable k0 equal $(1/(100*v_lS)) #screening length in cm^-1
variable k0 equal 334830907.19551110268 

#---------------initialization------------------
units cgs #mass: gram, distangce:angstrom, time:sec temp: Kelvin
dimension 3
atom_style atomic
boundary p p p #periodic
region simbox block 0 $(v_side) 0 $(v_side) 0 $(v_side) #sim volume
region simbox block 0 9.4706520693321304065e-07 0 $(v_side) 0 $(v_side) 
region simbox block 0 9.4706520693321304065e-07 0 9.4706520693321304065e-07 0 $(v_side) 
region simbox block 0 9.4706520693321304065e-07 0 9.4706520693321304065e-07 0 9.4706520693321304065e-07 
pair_style yukawa $(v_k0) $(v_side/20) #first is kappa inverse distance units, second is r_cutoff
pair_style yukawa 334830907.19551098347 $(v_side/20) 
pair_style yukawa 334830907.19551098347 4.7353260346660652033e-08 
create_box 2 simbox
Created orthogonal box = (0 0 0) to (9.4706521e-07 9.4706521e-07 9.4706521e-07)
  5 by 2 by 2 MPI processor grid



#--------------------Settings-----------------
mass 1 $(v_mH*1000) #Hydrogen mass in grams
mass 1 1.6738625041514401818e-24 
mass 2 $(v_mSi*1000) #Silicon mass in grams
mass 2 4.6645632680172703138e-23 
timestep $(v_dt)
timestep 1.1784359821947600744e-17
create_atoms 1 random $(v_NH) 34134 simbox overlap 5.0e-9 #label, random positions, number, seed, region, minimize close contacts
create_atoms 1 random 500000 34134 simbox overlap 5.0e-9 
Created 500000 atoms
  using lattice units in orthogonal box = (0 0 0) to (9.4706521e-07 9.4706521e-07 9.4706521e-07)
  create_atoms CPU = 7831.703 seconds
create_atoms 2 random $(v_NSi) 12756 simbox overlap 5.0e-9
create_atoms 2 random 2000 12756 simbox overlap 5.0e-9
Created 2000 atoms
  using lattice units in orthogonal box = (0 0 0) to (9.4706521e-07 9.4706521e-07 9.4706521e-07)
  create_atoms CPU = 36.388 seconds
group Si type 2
2000 atoms in group Si
group H type 1
500000 atoms in group H

variable n equal $(v_side/20)
variable n equal 4.7353260346660652033e-08
neigh_modify every 1 delay 0 check yes
neighbor ${n} bin
neighbor 4.73532603466607e-08 bin
neigh_modify one 10000
neigh_modify page 100000
pair_coeff 1 1 $(v_ZH*v_ZH*v_qe*v_qe*v_ctostatc*v_ctostatc)
pair_coeff 1 1 9.7473728220159717242e-20
pair_coeff 1 2 $(v_ZSi*v_ZH*v_qe*v_qe*v_ctostatc*v_ctostatc)
pair_coeff 1 2 5.7284560277078476794e-19
pair_coeff 2 2 $(v_ZSi*v_ZSi*v_qe*v_qe*v_ctostatc*v_ctostatc)
pair_coeff 2 2 3.3665695424375347985e-18
velocity all create $(v_T0) 68534 dist gaussian
velocity all create 5000 68534 dist gaussian


#--------output----------------
thermo 100
compute tempH H temp
compute tempSi Si temp
thermo_style custom step time temp c_tempH c_tempSi etotal pe ke press v_k0 v_dt v_collfreq v_ccs
dump mydmp Si custom 100 trajvel_v9.0e+06_c1.txt id type vx vy vz
log unforcedvel_v9.0e+06_c1.log
