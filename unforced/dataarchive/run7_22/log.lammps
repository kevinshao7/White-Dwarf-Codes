LAMMPS (23 Jun 2022 - Update 1)
#---------------initialization------------------
units cgs #mass: gram, distangce:angstrom, time:femtosec temp: Kelvin
dimension 3
atom_style atomic
boundary p p p #periodic
region simbox block -1e-7 1e-7 -1e-7 1e-7 -1e-7 1e-7 #sim volume (60 angstrom)^3
pair_style yukawa 26527232. 5e-9 #first is kappa inverse distance units, second is r_cutoff
create_box 2 simbox
Created orthogonal box = (-1e-07 -1e-07 -1e-07) to (1e-07 1e-07 1e-07)
  2 by 3 by 5 MPI processor grid

# -----------Changeable parameters -----------


variable vz equal 6.0e+06
variable T0 equal 15000
variable dt equal 2.0e-18 #2e-17 sec
variable mH equal 1.008 #Hydrogen mass g/mol
variable mSi equal 28.09 #Silicon mass g/mol
variable NH equal 250000
variable NSi equal 2000
variable density equal 1.0 #g/cm^3

#--------------------Settings-----------------
variable avogadro equal 6.022e23
mass 1 $(v_mH/v_avogadro) #Hydrogen
mass 1 1.6738625041514445899e-24 
mass 2 $(v_mSi/v_avogadro) #Silicon
mass 2 4.664563268017269726e-23 
variable vol equal $((v_mH*v_NH+v_mSi*v_NSi)/(v_avogadro*v_density)) #cm^3
variable vol equal 5.1175689139820658447e-19 
variable side equal $((v_vol^(1/3))/2) #cm -> side coordinate
variable side equal 3.9993668044539728716e-07 

timestep $(v_dt)
timestep 2.0000000000000001431e-18
create_atoms 1 random $(v_NH) 34134 simbox overlap 1.0e-9 #label, random positions, number, seed, region, minimize close contacts
create_atoms 1 random 250000 34134 simbox overlap 1.0e-9 
Created 250000 atoms
  using lattice units in orthogonal box = (-1e-07 -1e-07 -1e-07) to (1e-07 1e-07 1e-07)
  create_atoms CPU = 3378.344 seconds
create_atoms 2 random $(v_NSi) 12756 simbox overlap $(0.3*(v_vol/v_NH)^(1/3))
create_atoms 2 random 2000 12756 simbox overlap $(0.3*(v_vol/v_NH)^(1/3))
create_atoms 2 random 2000 12756 simbox overlap 3.8091594435581605151e-09
WARNING: Only inserted 507 particles out of 2000 (../create_atoms.cpp:851)
Created 507 atoms
  using lattice units in orthogonal box = (-1e-07 -1e-07 -1e-07) to (1e-07 1e-07 1e-07)
  create_atoms CPU = 21728.236 seconds
group Si type 2
507 atoms in group Si
group H type 1
250000 atoms in group H
group test id 2
1 atoms in group test



change_box all x scale $(v_side*1e7) remap
change_box all x scale 3.9993668044539703033 remap
Changing box ...
  orthogonal box = (-3.9993668e-07 -1e-07 -1e-07) to (3.9993668e-07 1e-07 1e-07)
change_box all y scale $(v_side*1e7) remap
change_box all y scale 3.9993668044539703033 remap
Changing box ...
  orthogonal box = (-3.9993668e-07 -3.9993668e-07 -1e-07) to (3.9993668e-07 3.9993668e-07 1e-07)
change_box all z scale $(v_side*1e7) remap
change_box all z scale 3.9993668044539703033 remap
Changing box ...
  orthogonal box = (-3.9993668e-07 -3.9993668e-07 -3.9993668e-07) to (3.9993668e-07 3.9993668e-07 3.9993668e-07)

variable n equal ${side}/4
variable n equal 3.99936680445397e-07/4
neigh_modify every 1 delay 0 check yes
neighbor ${n} bin
neighbor 9.99841701113493e-08 bin
neigh_modify one 5000
neigh_modify page 50000
pair_coeff 1 1 2.307e-21
pair_coeff 1 2 2.307e-21
pair_coeff 2 2 2.307e-21
velocity all create $(v_T0) 68534 dist gaussian
velocity all create 15000 68534 dist gaussian


#--------output----------------
thermo 10
compute tempH H temp
compute tempSi Si temp

thermo_style custom step temp c_tempH c_tempSi etotal pe ke press
dump mydmp Si custom 10 trajvel_6.0e+06.txt id type vx vy vz
#dump mydmp2 test custom 1000 traj2.txt id type vx vy vz

log unforcedvel_6.0e+06.log
