#---------------initialization------------------
units cgs #mass: gram/mol, distangce:angstrom, time:femtosec temp: Kelvin
dimension 3
atom_style atomic
boundary p p p #periodic
region simbox block -1e-7 1e-7 -1e-7 1e-7 -1e-7 1e-7 #sim volume (60 angstrom)^3
pair_style yukawa 7.66e8 5e-8 #first is kappa inverse distance units, second is r_cutoff
create_box 2 simbox

# -----------Changeable parameters -----------


variable vz equal 1.0e7
variable T0 equal 15000
variable dt equal 2.0e-17 #2e-17 sec
variable mH equal 1.008 #Hydrogen mass g/mol
variable mSi equal 28.09 #Silicon mass g/mol
variable NH equal 50000
variable NSi equal 100
variable density equal 1.0 #g/cm^3

#--------------------Settings-----------------
timestep $(v_dt)
create_atoms 1 random $(v_NH) 34134 simbox overlap 4.0e-9 #label, random positions, number, seed, region, minimize close contacts
create_atoms 2 random $(v_NSi) 12756 simbox overlap 4.0e-9
group Si type 2
group H type 1
group test id 2

variable avogadro equal 6.022e23
mass 1 $(v_mH/v_avogadro) #Hydrogen
mass 2 $(v_mSi/v_avogadro) #Silicon
variable vol equal $((v_mH*v_NH+v_mSi*v_NSi)/(v_avogadro*v_density)) #cm^3
variable side equal $((v_vol^(1/3))/2) #cm -> side coordinate

change_box all x scale $(v_side*1e8) remap
change_box all y scale $(v_side*1e8) remap
change_box all z scale $(v_side*1e8) remap

variable n equal ${side}/4
neigh_modify every 1 delay 0 check yes
neighbor ${n} bin
pair_coeff 1 1 2.31e-19
pair_coeff 1 2 3.069e-18
pair_coeff 2 2 3.069e-18
velocity all create $(v_T0) 68534 dist gaussian


#--------output----------------
thermo 1000
thermo_style custom step temp etotal pe ke press
dump mydmp Si custom 1000 traj.txt id type vx vy vz
#dump mydmp2 test custom 1000 traj2.txt id type vx vy vz

log firstlog

#-----------------Run-----------------------
#minimize 1.0e-9 1.0e-9 1000 1000
fix mynvt H nvt temp $(v_T0) $(v_T0) $(100.0*v_dt)
run 1000
unfix mynvt
velocity Si set 0 0 $(v_vz) sum no

fix mynve all nve 
run 10000000
